    "paired=pd.DataFrame([{'n_gated':int(g.sum()),'GATE_ONLY_n_trades':int((pol['GATE_ONLY'][g]!=0).sum()),'HIDDEN_AWARE_n_trades':int((pol['HIDDEN_AWARE'][g]!=0).sum()),'action_agreements':int((pol['GATE_ONLY'][g]==pol['HIDDEN_AWARE'][g]).sum()),'action_disagreements':int((pol['GATE_ONLY'][g]!=pol['HIDDEN_AWARE'][g]).sum()),'action_disagreement_pct':float((pol['GATE_ONLY'][g]!=pol['HIDDEN_AWARE'][g]).mean()),'mean_D':float(d.mean()),'median_D':float(np.median(d)),'std_D':float(np.std(d,ddof=1)),'n_D_gt_0':int((d>0).sum()),'n_D_eq_0':int((d==0).sum()),'n_D_lt_0':int((d<0).sum()),'cumulative_D':float(d.sum()),'mu_gate':float(gf.params[0]),'HAC_SE':float(gf.bse[0]),'HAC_t':float(gf.tvalues[0]),'HAC_p':float(gf.pvalues[0]),'HAC_CI_low':float(gci[0]),'HAC_CI_high':float(gci[1]),'gate_frequency':float(g.mean()),'deployment_scaled_mean':float(gf.params[0]*g.mean()),'full_chronology_cumulative_difference':float(economics.set_index('policy').loc['HIDDEN_AWARE','cumulative_net_pnl']-economics.set_index('policy').loc['GATE_ONLY','cumulative_net_pnl'])}])\n"
   ]
