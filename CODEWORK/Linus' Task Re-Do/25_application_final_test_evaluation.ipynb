    "# ============================================================\n",
    "# THESIS FIGURE 6.2\n",
    "# Final TEST cumulative net PnL differences\n",
    "#\n",
    "# Panel (a):\n",
    "#   GATE ONLY minus BASE\n",
    "#   -> change associated with restricting deployment\n",
    "#\n",
    "# Panel (b):\n",
    "#   HIDDEN AWARE minus GATE ONLY\n",
    "#   -> incremental contribution of hidden-response information\n",
    "#\n",
    "# Plotting only.\n",
    "# No predictions, actions, policies or scientific calculations\n",
    "# are changed.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.dates as mdates\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Project / export directory\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "PROJECT_ROOT = (\n",
    "    Path(PROJECT_DIR)\n",
    "    if \"PROJECT_DIR\" in globals()\n",
    "    else Path(PROJECT)\n",
    "    if \"PROJECT\" in globals()\n",
    "    else Path.cwd()\n",
    ")\n",
    "\n",
    "THESIS_PLOTS = PROJECT_ROOT / \"plots\" / \"empirical_work\"\n",
    "THESIS_PLOTS.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Frozen TEST policy PnLs from N25\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "base_pnl = np.asarray(\n",
    "    pnl(pol[\"BASE\"]),\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "gate_only_pnl = np.asarray(\n",
    "    pnl(pol[\"GATE_ONLY\"]),\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "hidden_aware_pnl = np.asarray(\n",
    "    pnl(pol[\"HIDDEN_AWARE\"]),\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "decision_days = pd.to_datetime(\n",
    "    evalp[KEY].copy()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# POLICY DIFFERENCES\n",
    "# ============================================================\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Panel (a)\n",
    "#\n",
    "# Positive values:\n",
    "#   GATE ONLY has accumulated more net PnL than BASE.\n",
    "#\n",
    "# This comparison changes both deployment frequency and\n",
    "# realised trading outcome. It is therefore interpreted as\n",
    "# the deployment-restriction comparison, not as the isolated\n",
    "# contribution of hidden-response information.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "deployment_difference = (\n",
    "    gate_only_pnl\n",
    "    - base_pnl\n",
    ")\n",
    "\n",
    "cum_deployment_difference = np.cumsum(\n",
    "    deployment_difference\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Panel (b)\n",
    "#\n",
    "# Positive values:\n",
    "#   HIDDEN AWARE has accumulated more net PnL than GATE ONLY.\n",
    "#\n",
    "# Both policies use the same episode-entry opportunity set,\n",
    "# so this is the direct incremental hidden-information\n",
    "# comparison.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "hidden_information_difference = (\n",
    "    hidden_aware_pnl\n",
    "    - gate_only_pnl\n",
    ")\n",
    "\n",
    "cum_hidden_information_difference = np.cumsum(\n",
    "    hidden_information_difference\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# INTEGRITY CHECKS\n",
    "# ============================================================\n",
    "\n",
    "assert len(decision_days) == 901\n",
    "\n",
    "assert len(cum_deployment_difference) == 901\n",
    "assert len(cum_hidden_information_difference) == 901\n",
    "\n",
    "assert int(evalp[\"G_t\"].sum()) == 74\n",
    "\n",
    "\n",
    "# Outside the fixed opportunity set, GATE ONLY and\n",
    "# HIDDEN AWARE must have zero incremental difference.\n",
    "assert np.allclose(\n",
    "    hidden_information_difference[\n",
    "        evalp[\"G_t\"].eq(0).to_numpy()\n",
    "    ],\n",
    "    0.0,\n",
    "    rtol=0,\n",
    "    atol=1e-12\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reconcile exactly with frozen N25 economic results\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "economics_indexed = (\n",
    "    economics\n",
    "    .set_index(\"policy\")\n",
    ")\n",
    "\n",
    "expected_base = (\n",
    "    economics_indexed\n",
    "    .loc[\"BASE\", \"cumulative_net_pnl\"]\n",
    ")\n",
    "\n",
    "expected_gate_only = (\n",
    "    economics_indexed\n",
    "    .loc[\"GATE_ONLY\", \"cumulative_net_pnl\"]\n",
    ")\n",
    "\n",
    "expected_hidden_aware = (\n",
    "    economics_indexed\n",
    "    .loc[\"HIDDEN_AWARE\", \"cumulative_net_pnl\"]\n",
    ")\n",
    "\n",
    "\n",
    "expected_deployment_difference = (\n",
    "    expected_gate_only\n",
    "    - expected_base\n",
    ")\n",
    "\n",
    "expected_hidden_information_difference = (\n",
    "    expected_hidden_aware\n",
    "    - expected_gate_only\n",
    ")\n",
    "\n",
    "\n",
    "assert np.isclose(\n",
    "    cum_deployment_difference[-1],\n",
    "    expected_deployment_difference,\n",
    "    rtol=0,\n",
    "    atol=1e-12\n",
    ")\n",
    "\n",
    "assert np.isclose(\n",
    "    cum_hidden_information_difference[-1],\n",
    "    expected_hidden_information_difference,\n",
    "    rtol=0,\n",
    "    atol=1e-12\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# THESIS-STYLE TYPOGRAPHY\n",
    "# ============================================================\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"font.family\": \"serif\",\n",
    "    \"font.serif\": [\n",
    "        \"Times New Roman\",\n",
    "        \"DejaVu Serif\"\n",
    "    ],\n",
    "    \"mathtext.fontset\": \"dejavuserif\",\n",
    "    \"axes.unicode_minus\": False,\n",
    "})\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# FIGURE SETUP\n",
    "# ============================================================\n",
    "\n",
    "fig, (ax_top, ax_bottom) = plt.subplots(\n",
    "    2,\n",
    "    1,\n",
    "    figsize=(8.6, 6.1),\n",
    "    sharex=True,\n",
    "    gridspec_kw={\n",
    "        \"height_ratios\": [1.35, 1.0],\n",
    "        \"hspace\": 0.10\n",
    "    },\n",
    "    constrained_layout=True\n",
    ")\n",
    "\n",
    "\n",
    "fig.suptitle(\n",
    "    \"Final TEST cumulative net PnL differences\",\n",
    "    fontsize=13.5,\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL (a)\n",
    "# GATE ONLY MINUS BASE\n",
    "# ============================================================\n",
    "\n",
    "ax_top.plot(\n",
    "    decision_days,\n",
    "    cum_deployment_difference,\n",
    "    linewidth=2.0\n",
    ")\n",
    "\n",
    "\n",
    "# Zero means no cumulative difference between policies.\n",
    "ax_top.axhline(\n",
    "    0,\n",
    "    linewidth=0.7,\n",
    "    alpha=0.40\n",
    ")\n",
    "\n",
    "\n",
    "ax_top.set_title(\n",
    "    \"(a) GATE ONLY minus BASE: deployment restriction\",\n",
    "    loc=\"left\",\n",
    "    fontsize=10.8,\n",
    "    fontweight=\"bold\",\n",
    "    pad=6\n",
    ")\n",
    "\n",
    "\n",
    "ax_top.set_ylabel(\n",
    "    \"Cumulative net PnL\\ndifference\",\n",
    "    fontsize=10.2\n",
    ")\n",
    "\n",
    "\n",
    "ax_top.tick_params(\n",
    "    axis=\"both\",\n",
    "    labelsize=9.0\n",
    ")\n",
    "\n",
    "ax_top.margins(\n",
    "    x=0.01\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Final deployment-difference annotation\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "ax_top.annotate(\n",
    "    f\"Final difference = {cum_deployment_difference[-1]:+.2f}\",\n",
    "    xy=(\n",
    "        decision_days.iloc[-1],\n",
    "        cum_deployment_difference[-1]\n",
    "    ),\n",
    "    xytext=(-135, -85),\n",
    "    textcoords=\"offset points\",\n",
    "    fontsize=8.8,\n",
    "    ha=\"left\",\n",
    "    va=\"top\",\n",
    "    arrowprops=dict(\n",
    "        arrowstyle=\"->\",\n",
    "        linewidth=0.7\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL (b)\n",
    "# HIDDEN AWARE MINUS GATE ONLY\n",
    "# ============================================================\n",
    "\n",
    "ax_bottom.step(\n",
    "    decision_days,\n",
    "    cum_hidden_information_difference,\n",
    "    where=\"post\",\n",
    "    linewidth=2.0\n",
    ")\n",
    "\n",
    "\n",
    "# Zero means no cumulative incremental advantage.\n",
    "ax_bottom.axhline(\n",
    "    0,\n",
    "    linewidth=0.7,\n",
    "    alpha=0.40\n",
    ")\n",
    "\n",
    "\n",
    "ax_bottom.set_title(\n",
    "    \"(b) HIDDEN AWARE minus GATE ONLY: hidden-response information\",\n",
    "    loc=\"left\",\n",
    "    fontsize=10.8,\n",
    "    fontweight=\"bold\",\n",
    "    pad=6\n",
    ")\n",
    "\n",
    "\n",
    "ax_bottom.set_ylabel(\n",
    "    \"Cumulative net PnL\\ndifference\",\n",
    "    fontsize=10.2\n",
    ")\n",
    "\n",
    "\n",
    "ax_bottom.set_xlabel(\n",
    "    \"Decision model day\",\n",
    "    fontsize=10.5\n",
    ")\n",
    "\n",
    "\n",
    "ax_bottom.tick_params(\n",
    "    axis=\"both\",\n",
    "    labelsize=9.0\n",
    ")\n",
    "\n",
    "ax_bottom.margins(\n",
    "    x=0.01\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Final hidden-information difference annotation\n",
    "#\n",
    "# Positioned below-left of the final point to avoid sitting\n",
    "# directly over the final horizontal step.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "ax_bottom.annotate(\n",
    "    f\"Final difference = {cum_hidden_information_difference[-1]:+.2f}\",\n",
    "    xy=(\n",
    "        decision_days.iloc[-1],\n",
    "        cum_hidden_information_difference[-1]\n",
    "    ),\n",
    "    xytext=(-125, -24),\n",
    "    textcoords=\"offset points\",\n",
    "    fontsize=8.8,\n",
    "    ha=\"left\",\n",
    "    va=\"top\",\n",
    "    arrowprops=dict(\n",
    "        arrowstyle=\"->\",\n",
    "        linewidth=0.7\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# SHARED DATE AXIS\n",
    "# ============================================================\n",
    "\n",
    "ax_bottom.xaxis.set_major_locator(\n",
