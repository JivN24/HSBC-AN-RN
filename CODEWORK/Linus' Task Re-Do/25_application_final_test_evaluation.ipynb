    "# does not need to change.\n",
    "# ============================================================\n",
    "\n",
    "pdf_path = (\n",
    "    THESIS_PLOTS /\n",
    "    \"fig_6_2_frozen_test_cumulative_net_pnl.pdf\"\n",
    ")\n",
    "\n",
    "png_path = (\n",
    "    THESIS_PLOTS /\n",
    "    \"fig_6_2_frozen_test_cumulative_net_pnl.png\"\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "    pdf_path,\n",
    "    bbox_inches=\"tight\",\n",
    "    pad_inches=0.06\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    png_path,\n",
    "    dpi=300,\n",
    "    bbox_inches=\"tight\",\n",
    "    pad_inches=0.06\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# AUDIT OUTPUT\n",
    "# ============================================================\n",
    "\n",
    "print(\"THESIS FIGURE 6.2 EXPORTED\")\n",
    "print(\"PDF:\", pdf_path)\n",
    "print(\"PNG:\", png_path)\n",
    "\n",
    "print()\n",
    "print(\"Frozen cumulative policy PnLs:\")\n",
    "print(\"BASE:\", float(expected_base))\n",
    "print(\"GATE ONLY:\", float(expected_gate_only))\n",
    "print(\"HIDDEN AWARE:\", float(expected_hidden_aware))\n",
    "\n",
    "print()\n",
    "print(\n",
    "    \"Final GATE ONLY - BASE:\",\n",
    "    float(cum_deployment_difference[-1])\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Expected GATE ONLY - BASE:\",\n",
    "    float(expected_deployment_difference)\n",
    ")\n",
    "\n",
    "print()\n",
    "print(\n",
    "    \"Final HIDDEN AWARE - GATE ONLY:\",\n",
    "    float(cum_hidden_information_difference[-1])\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Expected HIDDEN AWARE - GATE ONLY:\",\n",
    "    float(expected_hidden_information_difference)\n",
    ")\n",
    "\n",
    "print()\n",
    "print(\n",
    "    \"Gate opportunities:\",\n",
    "    int(evalp[\"G_t\"].sum())\n",
    ")\n",
    "\n",
    "print()\n",
    "print(\"Predictions changed: NO\")\n",
    "print(\"Actions changed: NO\")\n",
    "print(\"Policy PnLs changed: NO\")\n",
    "print(\"Scientific calculations changed: NO\")"
   ]
